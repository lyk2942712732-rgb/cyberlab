# Generate a real .env with: python scripts/init_env.py
POSTGRES_USER=cyberlab
POSTGRES_DB=cyberlab
POSTGRES_PASSWORD=replace-with-random-database-password
SECRET_KEY=replace-with-at-least-32-random-characters
ORCHESTRATOR_SECRET=replace-with-another-32-random-characters
PUBLIC_ORIGIN=http://localhost:8080
HTTP_PORT=8080
CYBERLAB_DATA_DIR=/var/lib/cyberlab
MAX_UPLOAD_MB=1024
MAX_ACTIVE_SESSIONS=20
KALI_IMAGE=cyberlab/kali:local
KALI_CPU=2
KALI_MEMORY_MB=2048
WORKER_INTERVAL=1
ADMIN_PASSWORD=replace-with-admin-password
STUDENT_PASSWORD=replace-with-student-password
